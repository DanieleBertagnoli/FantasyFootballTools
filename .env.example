# Copy this file to `.env` and replace the example values:
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#   python src/main.py
#
# The `.env` file contains local configuration and must not be committed.

# Required outside local development: a long random string used to sign Flask
# session cookies. Generate a new one for every environment, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Path to the JSON generated by `python src/scrape_players.py`.
# Leave it blank/commented to use `src/instance/player_catalogue.json`.
# If set, use the same value for both the scraper and `main.py`.
# PLAYER_CATALOGUE_PATH=/absolute/path/to/player_catalogue.json

# The catalogue is updated manually with the scraper: keep this at `0` to
# start the server immediately. At `1`, Flask tries to sync Wikipedia during
# startup and may therefore take some time.
PLAYER_CATALOGUE_SYNC_ON_STARTUP=0

# Number of hours after which the scraper considers the catalogue current and
# skips another Wikipedia download. Positive integer; maximum 720 (30 days).
PLAYER_CATALOGUE_SYNC_INTERVAL_HOURS=24

# Timeout in seconds for each Wikipedia request. Integer from 1 to 60.
PLAYER_CATALOGUE_TIMEOUT_SECONDS=20

# Month (1-12) in which the Serie A season rolls over to the next year.
# 7 means July: through 30 June 2027 the active season is 2026-2027; from
# 1 July it is 2027-2028.
PLAYER_CATALOGUE_SEASON_START_MONTH=7
