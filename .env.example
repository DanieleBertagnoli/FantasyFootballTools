# Copy this file to `.env`, replace every example secret, then start the stack:
#
#   cp .env.example .env
#   docker compose up --build
#
# Both the Flask app and MariaDB receive this file through Compose. It contains
# secrets and must never be committed. Persistent data is stored locally in
# the gitignored `persistent_data/` directory.

# Required outside local development: a long random string used to sign Flask
# session cookies. Generate a new one for every environment, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Runtime. Docker uses Gunicorn in production mode. Keep APP_BASE_URL on the
# final HTTPS public URL; this automatically enables Secure session cookies
# and HSTS. Set SESSION_COOKIE_SECURE=0 only for a local HTTP development run.
APP_ENV=production
APP_PORT=5010
APP_BASE_URL=https://fantasta.example.com
TRUST_PROXY_HEADERS=1
ALLOWED_HOSTS=fantasta.example.com
# Optional Gunicorn tuning for the available CPU/RAM.
# GUNICORN_CMD_ARGS=--bind=0.0.0.0:5010 --workers=2 --threads=4 --worker-tmp-dir=/dev/shm --timeout=60 --graceful-timeout=30 --access-logfile=- --error-logfile=- --capture-output

# MariaDB. DB_HOST is the Compose service name: do not use localhost from the
# app container. MARIADB_ROOT_PASSWORD is used only by the database container.
DB_HOST=db
DB_PORT=3306
MARIADB_DATABASE=fantasyfootballtools
MARIADB_USER=fantasyfootballtools
MARIADB_PASSWORD=replace-with-a-long-random-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-root-password

# Registration and password-reset email. For Gmail, create an App Password
# (not the normal account password) and put it in MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=wedev.danielebertagnoli@gmail.com
MAIL_PASSWORD=replace-with-the-gmail-app-password
MAIL_FROM=wedev.danielebertagnoli@gmail.com
MAIL_USE_TLS=1

# Account access and one-time-link lifetimes, in seconds. Leave login
# protection enabled in every deployed environment.
AUTH_REQUIRE_LOGIN=1
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# GDPR / legal notice. Replace all three values with the actual details of the
# data controller before publishing the service.
LEGAL_DATA_CONTROLLER_NAME=Nome o ragione sociale del titolare
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_BUSINESS_ADDRESS=Indirizzo del titolare
LEGAL_LAST_UPDATED=5 settembre 2026

# The player catalogue always lives at `persistent_data/player_catalogue.json`.
# There is intentionally no PLAYER_CATALOGUE_PATH setting.

# The catalogue is updated manually with the scraper: keep this at `0` to
# start the server immediately. At `1`, Flask tries to sync Wikipedia during
# startup and may therefore take some time.
PLAYER_CATALOGUE_SYNC_ON_STARTUP=0

# Number of hours after which the scraper considers the catalogue current and
# skips another Wikipedia download. Positive integer; maximum 720 (30 days).
PLAYER_CATALOGUE_SYNC_INTERVAL_HOURS=24

# Timeout in seconds for each Wikipedia request. Integer from 1 to 60.
PLAYER_CATALOGUE_TIMEOUT_SECONDS=20

# Month (1-12) in which the Serie A season rolls over to the next year.
# 7 means July: through 30 June 2027 the active season is 2026-2027; from
# 1 July it is 2027-2028.
PLAYER_CATALOGUE_SEASON_START_MONTH=7
